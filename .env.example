# Application
APP_NAME=MailPulse
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://mailpulse:mailpulse@localhost:5433/mailpulse

# Redis (reserved for queue workers — Phase 3)
REDIS_URL=redis://localhost:6379/0

# JWT authentication
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
CREDENTIAL_ENCRYPTION_KEY=
EMAIL_MONITOR_POLL_INTERVAL_SECONDS=60
ARQ_MAX_TRIES=4
ARQ_JOB_TIMEOUT=300
WEBHOOK_MAX_ATTEMPTS=4

# CORS (comma-separated origins optional — defaults include localhost:5173)
# CORS_ORIGINS=["http://localhost:5173"]

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
