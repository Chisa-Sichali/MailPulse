# ─────────────────────────────────────────────────────────────────────────────
# MailPulse backend — environment template
#
# Copy this file to `.env` and fill in real values, or run
# `scripts/generate-env.sh` to generate a `.env` with safe defaults for
# local development and Docker Compose.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME=MailPulse
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# Database — local dev uses host port 5433 (5432 is reserved for a
# system Postgres if present). Inside Docker Compose the host part is
# overridden to `postgres:5432` (see docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://mailpulse:mailpulse@localhost:5433/mailpulse

REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
CREDENTIAL_ENCRYPTION_KEY=
EMAIL_MONITOR_POLL_INTERVAL_SECONDS=60
ARQ_MAX_TRIES=4
ARQ_JOB_TIMEOUT=300
WEBHOOK_MAX_ATTEMPTS=4

# CORS — comma-separated origins optional.
# Defaults (if unset) already allow localhost:5173/3000 + 127.0.0.1 variants.
# CORS_ORIGINS=["http://localhost:5173"]

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7