# ─────────────────────────────────────────────────────────────────────────────
# MailPulse dashboard (Next.js) — environment template
#
# Copy this file to `.env.local` for local development, or run
# `scripts/generate-env.sh` to generate values for Docker Compose.
#
# ⚠️  NEXT_PUBLIC_* vars are inlined into the client bundle at BUILD time.
#      Changing them requires a rebuild (`docker compose build dashboard`).
#
# `NEXT_PUBLIC_API_URL` is the dashboard's own origin. When served by the
# Next.js standalone server this stays http://localhost:3000 (the port the
# container publishes). If you run the dashboard on another port, change it.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Base URL of the FastAPI backend. Outside Docker, the API runs on 8080;
# inside Docker Compose the service name `api` must be used instead.
NEXT_PUBLIC_FASTAPI_BACKEND_URL=http://localhost:8080
