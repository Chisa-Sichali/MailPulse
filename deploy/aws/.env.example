# Copy to deploy/aws/.env and replace every placeholder.
# Never commit deploy/aws/.env.

APP_NAME=MailPulse
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# Public URL of the EC2-hosted MailPulse instance.
# No trailing slash.
MAILPULSE_PUBLIC_URL=http://YOUR_EC2_PUBLIC_IP

# Database password used by the bundled PostgreSQL container.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Application secrets.
JWT_SECRET_KEY=replace-with-a-long-random-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
CRON_SECRET_KEY=replace-with-a-long-random-secret

EMAIL_MONITOR_POLL_INTERVAL_SECONDS=60
ARQ_MAX_TRIES=4
ARQ_JOB_TIMEOUT=300
WEBHOOK_MAX_ATTEMPTS=4

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
